# Add these values in Render's Environment page. Do not commit a real .env file.
# Create a Backblaze B2 application key limited to this bucket/prefix with readFiles only.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Optional: only expose objects beneath this folder. Leave blank when files are at bucket root.
B2_FILE_PREFIX=

# Your public Render/custom-domain URL; no trailing slash.
ASSET_PUBLIC_URL=https://your-service.onrender.com

# Comma-separated old URL origins in the song database that should be served from B2.
# B2 object keys must match the URL paths after the domain, such as public/map/....
ASSET_PROXY_ORIGINS=https://jd-s3.example.com,https://cdn.example.com
